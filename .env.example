# ────────��────────────────────────────────────
# Database (Neon Postgres — serverless)
# Crie em: https://neon.tech
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/spylab?sslmode=require

# ──────────────────────���──────────────────────
# Auth.js v5 (Google OAuth)
# Configure em: https://console.cloud.google.com → APIs → OAuth 2.0
# Redirect URI: http://localhost:3000/api/auth/callback/google
# ────────────────────────���────────────────────
NEXTAUTH_SECRET=gere_com_openssl_rand_-base64_32
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# ───────────────────────────────────────────��─
# Apify (scraping da Biblioteca de Anúncios FB)
# https://apify.com → Settings → Integrations → API tokens
# ─────────────────────────────────────────────
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────��──────
# Gemini (análise de copy com IA)
# Pegue grátis em: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# Inngest (background jobs)
# Desenvolvimento local: rodar `npx inngest-cli@latest dev`
# Produção: https://app.inngest.com → App Settings
# ────────────────────────────────────��────────
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# (Opcional) URL base — Next.js 15 detecta automaticamente em dev
# ────────────────────��────────────────────────
# NEXTAUTH_URL=https://app.seudominio.com
