# Apify API token (obrigatório)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API key (opcional — se ausente, o analyzer usa heurística)
# Pegue em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo Gemini (default: gemini-2.5-flash)
# Opções comuns: gemini-2.5-flash (rápido/barato), gemini-2.5-pro (mais qualidade)
GEMINI_MODEL=gemini-2.5-flash

# Quantos anúncios buscar no total (default 100)
ADS_COUNT=100

# Quantos anúncios "validados" (rodando há mais tempo) entrar no relatório (default 30)
TOP_N=30
